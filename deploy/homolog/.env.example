# Environment secrets / vars for homolog on mac-srv-01.
# Copy to the host deploy directory as `.env` (never commit real values).
# GitHub Environment `homolog` may also store MEDIA_HUB_API_KEY as a secret.

MEDIA_HUB_API_KEY=
MEDIA_HUB_PORT=8010

# Host paths on mac-srv-01 (adjust to the runner's data directory)
# MEDIA_HUB_HOST_ENV=/var/lib/media-hub/homolog/.env
# MEDIA_HUB_HOST_LOGS=/var/lib/media-hub/homolog/logs
# MEDIA_HUB_HOST_OUTPUT=/var/lib/media-hub/homolog/output
# MEDIA_HUB_HOST_REGISTRY=/var/lib/media-hub/homolog/registry.jsonl
